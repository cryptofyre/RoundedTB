<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>RoundedTB</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>RoundedTBCanary.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Unpackaged by default; pass -p:WindowsPackageType=MSIX for the MSIX package. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- UIAutomationClient is classic COM interop, which trimming otherwise disables. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Pulled in by the metapackage (and the toolkit) but never loaded: onnxruntime, DirectML, search. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings are (de)serialised by reflection. -->
    <TrimmerRootAssembly Include="RoundedTB" />
    <!-- Trimming unused interface members would shift the COM vtables. -->
    <TrimmerRootAssembly Include="Interop.UIAutomationClient" />
  </ItemGroup>

  <!-- The native DLL RoundedTB loads into Explorer to round the button highlights; it has to match
       Explorer's architecture, so it is built per runtime with MSVC (see RoundedTB.Tap\build.cmd). -->
  <PropertyGroup>
    <TapArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</TapArch>
    <TapArch Condition="'$(TapArch)' == ''">x64</TapArch>
    <TapDll>$(MSBuildThisFileDirectory)..\RoundedTB.Tap\bin\$(TapArch)\RoundedTB.Tap.dll</TapDll>
  </PropertyGroup>

  <Target Name="BuildTap" BeforeTargets="BeforeBuild" Inputs="..\RoundedTB.Tap\Tap.cpp;..\RoundedTB.Tap\Tap.def;..\RoundedTB.Tap\build.cmd" Outputs="$(TapDll)">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)..\RoundedTB.Tap\build.cmd&quot; $(TapArch)" />
  </Target>

  <ItemGroup>
    <Content Include="$(TapDll)" Link="RoundedTB.Tap.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="res\TrayDark.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="res\TrayLight.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\*.png" />
  </ItemGroup>

</Project>
